# CareerHub / JobAgent local environment
#
# Reference only: CareerHub does not automatically load .env files. Set these
# variables in your shell before startup. Do not commit real secrets or paths.

# Bundesagentur job search API client identifier.
# Check the official API documentation before use.
BUNDESAGENTUR_API_KEY=replace-with-public-client-identifier

# Optional OCR tool paths. Leave unset when tools are available on PATH.
TESSERACT_CMD=
POPPLER_PATH=

# Ollama Python-client host (application/profile/skill workflows).
OLLAMA_HOST=http://localhost:11434
# CompanyHub REST-client host and reviewer model; not a universal model override.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
